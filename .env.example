# ── قاعدة البيانات ───────────────────────────────────────────────
DATABASE_URL=postgresql://shipping:CHANGE_ME@localhost:5432/shipping_db
DB_POOL_MAX=20

# ── الخادم ───────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# ── الأمان ───────────────────────────────────────────────────────
# ولّد قيمة عشوائية طويلة: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=12h

# ── الواجهة ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# ── غلاف سطح المكتب ──────────────────────────────────────────────
# dev | bundled | remote
APP_SHELL_MODE=dev
APP_REMOTE_URL=
